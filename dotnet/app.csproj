<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- No RuntimeFrameworkVersion pin: dotnet-core-buildpack v2.4.52+ parses net10.0
         correctly and rolls forward to the newest 10.x runtime it bundles (10.0.11,
         the cgroup-v2 OOM fix). global.json pins the SDK (10.0.400) so a 10.x SDK is
         used; the runtime is resolved from this TargetFramework at finalize. -->
    <RollForward>LatestMinor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
</Project>
