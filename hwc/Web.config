<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal HWC (Hostable Web Core) app. The hwc_buildpack detects the app by this
  Web.config and hosts it on a Windows cell with HWC + the cell's .NET Framework.
  No Windows build is needed: default.aspx uses inline code that ASP.NET compiles
  on the cell at first request.
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
